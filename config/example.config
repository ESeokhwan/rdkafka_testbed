# Example configuration file for many_args_template.sh
#
# This file should be sourced by the script, so it must be valid shell syntax.
# Use KEY="VALUE" format. Lines starting with # are comments.

# --file <path>
# Example: FILE="/etc/hosts"
FILE=""

# --output <dir>
# Example: OUTPUT_DIR="/tmp/script_output"
OUTPUT_DIR="./output"

# --count <num>
# Example: COUNT=20
COUNT=5

# --verbose
# Set to 1 to enable, 0 to disable.
# Example: VERBOSE=1
VERBOSE=0
